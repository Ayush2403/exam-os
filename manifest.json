      "url": "./index.html#/dashboard",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Syllabus",
      "short_name": "Syllabus",
      "description": "Browse all topics",
      "url": "./index.html#/syllabus",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Log Mock",
      "short_name": "Mock",
      "description": "Record a mock test",
      "url": "./index.html#/mocks",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Error Log",
