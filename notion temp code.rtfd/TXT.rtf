function studyStreak()\{\
  const set=new Set();\
  S.sessions.forEach(s=>\{ if(s.lastReviewed) set.add(s.lastReviewed); if(s.logDate) set.add(s.logDate); \});\
  S.mocks.forEach(m=>\{ if(m.date) set.add(m.date); \});\
  let streak=0, cur=todayISO();\
  if(!set.has(cur)) cur=addDays(cur,-1);\
  while(set.has(cur))\{ streak++; cur=addDays(cur,-1); \}\
  return streak;\
\}\
