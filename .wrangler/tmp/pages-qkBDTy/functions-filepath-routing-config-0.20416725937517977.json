{
  "routes": [
    {
      "routePath": "/api/sync/:roomId",
      "mountPath": "/api/sync",
      "method": "DELETE",
      "module": [
        "api/sync/[roomId].js:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/sync/:roomId",
      "mountPath": "/api/sync",
      "method": "GET",
      "module": [
        "api/sync/[roomId].js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/sync/:roomId",
      "mountPath": "/api/sync",
      "method": "OPTIONS",
      "module": [
        "api/sync/[roomId].js:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/sync/:roomId",
      "mountPath": "/api/sync",
      "method": "POST",
      "module": [
        "api/sync/[roomId].js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}