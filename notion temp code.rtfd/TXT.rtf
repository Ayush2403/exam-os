let weekOff=0;\
function mondayOf(off)\{ const d=new Date(); d.setDate(d.getDate()-((d.getDay()+6)%7)+(off||0)*7); return d; \}\
function weekKey()\{ return iso(mondayOf(weekOff)); \}\
function weekStats(off)\{ const m=S.habits[iso(mondayOf(off===undefined?weekOff:off))]||\{\}; let c=0;\
  Object.values(m).forEach(d=>Object.values(d).forEach(v=>\{ if(v) c++; \}));\
  return \{c,pct:Math.round(c/42*100)\}; \}\
