function recommend()\{\
  const due=dueSessions();\
  if(due.length)\{ const s=due[0], r=reviewState(s), t=topicById(s.topicId);\
    return \{k:r.st==="overdue"?"OVERDUE REVIEW":"REVIEW DUE",t:s.name,m:(t?esc(t.topic)+" \'b7 ":"")+s.stage+" \'b7 clear this first",act:\{a:"complete-review",id:s.id,label:"Complete Review"\}\}; \}\
  const ip=S.syllabus.filter(t=>["Learning","Practicing","Reviewing"].includes(t.status))\
    .sort((a,b)=>priRank(a)-priRank(b));\
  if(ip.length) return \{k:"KEEP THE STREAK",t:"Continue "+ip[0].topic,m:ip[0].status+" \'b7 "+ip[0].subject+" \'b7 push it to the next stage",act:\{a:"goto-syllabus",id:ip[0].id,label:"Open Syllabus"\}\};\
  const fresh=S.syllabus.filter(t=>t.status==="Not started"&&t.priority==="Critical"&&t.weightage==="High");\
  if(fresh.length) return \{k:"START FRESH",t:fresh[0].topic,m:"Critical priority \'b7 High weightage \'b7 "+fresh[0].subject,act:\{a:"goto-syllabus",id:fresh[0].id,label:"Open Syllabus"\}\};\
  return \{k:"ALL CLEAR",t:"Take a full-length mock",m:"No pending reviews \'97 test yourself instead",act:\{a:"goto-mocks",id:"",label:"Log a Mock"\}\};\
\}\
