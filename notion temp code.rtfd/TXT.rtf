function nextReview(s)\{\
  if(s.stage==="Mastered") return null;\
  if(!s.lastReviewed) return todayISO();\
  return addDays(s.lastReviewed,INTERVALS[STAGES.indexOf(s.stage)]);\
\}\
function reviewState(s)\{\
  if(s.stage==="Mastered") return \{st:"mastered",nr:null\};\
  const nr=nextReview(s), d=diffD(nr,todayISO());\
  if(!s.lastReviewed) return \{st:"new",nr\};\
  if(d<0) return \{st:"overdue",nr,days:-d\};\
  if(d===0) return \{st:"today",nr\};\
  return \{st:"future",nr,days:d\};\
\}\
const isDue=s=>["overdue","today","new"].includes(reviewState(s).st);\
function dueSessions()\{ return S.sessions.filter(isDue).sort((a,b)=>\{\
  const ra=reviewState(a), rb=reviewState(b);\
  const da=ra.st==="overdue"?-ra.days-1000:(ra.st==="new"?-500:0), db=rb.st==="overdue"?-rb.days-1000:(rb.st==="new"?-500:0);\
  return da-db || a.name.localeCompare(b.name);\
\});\}\
function completeReview(id)\{\
  const s=S.sessions.find(x=>x.id===id); if(!s) return;\
  const i=STAGES.indexOf(s.stage);\
  if(i>=STAGES.length-1)\{ toast("Already mastered \uc0\u55356 \u57286 "); return; \}\
  s.lastReviewed=todayISO(); s.stage=STAGES[i+1]; save();\
  const nr=nextReview(s);\
  toast(s.stage==="Mastered"?"\uc0\u55356 \u57286  Mastered!":"\u10003  Review logged \'97 "+s.stage, s.stage==="Mastered"?esc(s.name):"Next review "+fmtD(nr)+" ("+relD(nr)+")");\
  rerender();\
\}\
