function mockChart()\{\
  const ms=S.mocks.filter(m=>m.date).sort((a,b)=>a.date<b.date?-1:1);\
  if(!ms.length) return "";\
  const W=680,H=240,PL=38,PR=16,PT=16,PB=30;\
  const X=i=>ms.length===1? PL+(W-PL-PR)/2 : PL+i*(W-PL-PR)/(ms.length-1);\
  const Y=v=>PT+(100-Math.max(0,Math.min(100,+v||0)))*(H-PT-PB)/100;\
  const grid=[0,25,50,75,100].map(v=>`\cf11 <line \cf14 x1\cf13 ="$\{PL\}"\cf11  \cf14 y1\cf13 ="$\{Y(v)\}"\cf11  \cf14 x2\cf13 ="$\{W-PR\}"\cf11  \cf14 y2\cf13 ="$\{Y(v)\}"\cf11  \cf14 stroke\cf13 ="rgba(255,255,255,.06)"\cf11 />\cf2 \
    \cf11 <text \cf14 x\cf13 ="$\{PL-8\}"\cf11  \cf14 y\cf13 ="$\{Y(v)+4\}"\cf11  \cf14 fill\cf13 ="rgba(255,255,255,.35)"\cf11  \cf14 font-size\cf13 ="10"\cf11  \cf14 text-anchor\cf13 ="end"\cf11 >\cf2 $\{v\}\cf11 </text>\cf2 `).join("");\
  const xlab=ms.map((m,i)=>`\cf11 <text \cf14 x\cf13 ="$\{X(i)\}"\cf11  \cf14 y\cf13 ="$\{H-8\}"\cf11  \cf14 fill\cf13 ="rgba(255,255,255,.4)"\cf11  \cf14 font-size\cf13 ="10"\cf11  \cf14 text-anchor\cf13 ="middle"\cf11 >\cf2 $\{fmtD(m.date)\}\cf11 </text>\cf2 `).join("");\
  const line=(key,color)=>\{ const pts=ms.map((m,i)=>[X(i),Y(m[key])]);\
    return `\cf11 <polyline \cf14 points\cf13 ="$\{pts.map(p=>p[0].toFixed(1)+"\cf14 ,"+p[1].toFixed(1)).join("\cf11  \cf14 ")\}"\cf11  \cf14 fill\cf13 ="none"\cf11  \cf14 stroke\cf13 ="$\{color\}"\cf11  \cf14 stroke-width\cf13 ="2.5"\cf11  \cf14 stroke-linecap\cf13 ="round"\cf11  \cf14 stroke-linejoin\cf13 ="round"\cf11 />\cf2 `\
    +pts.map((p,i)=>`\cf11 <circle \cf14 cx\cf13 ="$\{p[0].toFixed(1)\}"\cf11  \cf14 cy\cf13 ="$\{p[1].toFixed(1)\}"\cf11  \cf14 r\cf13 ="4.5"\cf11  \cf14 fill\cf13 ="#202020"\cf11  \cf14 stroke\cf13 ="$\{color\}"\cf11  \cf14 stroke-width\cf13 ="2.5"\cf11 ><title>\cf2 $\{esc(ms[i].title)\} \'97 $\{key==="percentile"?"Percentile":"Accuracy"\}: $\{ms[i][key]\}\cf11 </title></circle>\cf2 `).join(""); \};\
  return `\cf11 <svg \cf14 viewBox\cf13 ="0 0 $\{W\} $\{H\}"\cf11  \cf14 role\cf13 ="img"\cf11  \cf14 aria-label\cf13 ="Mock score trend"\cf11 >\cf2 $\{grid\}$\{xlab\}$\{line("percentile","#5E9FE8")\}$\{line("accuracy","#72BC8F")\}\cf11 </svg>\cf2 `;\
\}\
