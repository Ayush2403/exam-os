    \cf11 <div \cf14 style\cf13 ="display:flex;align-items:baseline;gap:12px;margin-bottom:2px"\cf11 >\cf2 \
      \cf11 <span \cf14 id\cf13 ="wk-pct"\cf11  \cf14 style\cf13 ="font-size:30px;font-weight:750;letter-spacing:-.02em;color:$\{st.pct>=50?"\cf14 var(--green)":"var(--text)"\}"\cf11 >\cf2 $\{st.pct\}%\cf11 </span>\cf2 \
      \cf11 <span \cf14 class\cf13 ="muted small"\cf11  \cf14 id\cf13 ="wk-cnt"\cf11 >\cf2 $\{st.c\} of 42 actions \'b7 goal \cf10 &gt;\cf2 50%\cf11 </span></div>\cf2 \
